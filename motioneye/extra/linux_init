#!/usr/bin/env bash

set -e

Error_Out(){
  echo "ERROR: $1 Aborting ..." >&2
  exit 1
}

(( UID )) && Error_Out 'Root permissions required. Please run this command as root user, via "sudo" or "su".'

# Process CLI arguments
SKIP_SYSTEMD=0
SKIP_APT_UPDATE=0
MEYECTL=''
LIBCAMERA=''
while (( $# )); do
  case "$1" in
    '--skip-systemd') SKIP_SYSTEMD=1;;
    '--skip-apt-update') SKIP_APT_UPDATE=1;;
    '--libcamera') LIBCAMERA=1;;
    '--no-libcamera') LIBCAMERA=0;;
    '--meyectl') (( $# > 1 )) || Error_Out 'Missing path after "--meyectl".'; MEYECTL=$2; shift;;
    *) Error_Out "Invalid command-line argument \"$1\".";;
  esac
  shift
done

# Check meyectl path for the systemd unit
if (( ! SKIP_SYSTEMD )); then
  if [[ $MEYECTL ]]; then
    [[ -f $MEYECTL ]] || Error_Out "meyectl executable \"$MEYECTL\" given with --meyectl does not exist."
    [[ -x $MEYECTL ]] || Error_Out "meyectl file \"$MEYECTL\" given with --meyectl is not executable."
  else
    MEYECTL=$(command -v meyectl) || :
    if [[ ! $MEYECTL ]]; then
      if [[ -f '/usr/local/bin/meyectl' ]]; then
        MEYECTL='/usr/local/bin/meyectl'
        [[ -x $MEYECTL ]] || Error_Out "$MEYECTL is not executable. Please check your motionEye installation."
      else
        Error_Out 'meyectl executable has not been found. Please check your motionEye installation.'
      fi
    fi
  fi
  MEYECTL=$(realpath "$MEYECTL")
  [[ $MEYECTL =~ ^/(home|root)/ ]] && Error_Out 'This venv is located in a user home directory below /home or /root. This is not supported, as it violates basic security concepts. Move the venv to an appropriate directory like /opt, which is better suited for access by system services.'
fi

# Preload libcamera's V4L2 layer for motion and v4l2-ctl, for Raspberry Pi camera modules on the libcamera camera stack
if [[ ! $LIBCAMERA ]]; then
  LIBCAMERA=0
  # Already set: install the package and update the path again, as a repair step
  if [[ -f '/etc/motioneye/motioneye.conf' ]] && grep -q '^libcamera_v4l2 ' /etc/motioneye/motioneye.conf; then
    LIBCAMERA=1
  elif [[ -t 0 ]] && grep -qa 'Raspberry Pi' /proc/device-tree/model 2> /dev/null; then
    echo "NOTE: Through libcamera's V4L2 layer, other V4L2 cameras like USB webcams lose their controls (brightness etc.) and are listed by their libcamera name."
    read -rp 'Raspberry Pi detected. Use a camera module through libcamera (installs libcamera-v4l2)? [y/N] ' REPLY
    [[ $REPLY == [Yy]* ]] && LIBCAMERA=1
  fi
fi

# Install dependencies
if command -v apt-get > /dev/null; then
  echo 'INFO: APT-based distribution detected, installing motionEye dependencies'
  (( SKIP_APT_UPDATE )) || apt-get update
  # If matching package can be found, install from motion project GitHub releases
  MOTION='motion'
  DISTRO=''
  TMPDIR=''
  [[ -f '/etc/os-release' ]] && DISTRO=$(sed -n '/^VERSION_CODENAME=/{s/^[^=]*=//p;q}' /etc/os-release)
  if [[ $DISTRO ]]; then
    ARCH=$(dpkg --print-architecture)
    # On ARMv6 Raspberry Pi models, download armv6hf package
    PI=''
    [[ ${ARCH} == 'armhf' && $(uname -m) == 'armv6l' ]] && PI='pi_'
    echo "INFO: ${DISTRO^} on ${ARCH} detected, checking for latest motion package from GitHub releases"
    command -v curl > /dev/null || DEBIAN_FRONTEND='noninteractive' apt-get -y --no-install-recommends install curl
    URL=$(curl -sSfL 'https://api.github.com/repos/Motion-Project/motion/releases' | grep -Po "\"browser_download_url\": *\"\K[^\"]*\/${PI}${DISTRO}_motion_.*_${ARCH}\.deb(?=\")" | head -1)
    if [[ ${URL} ]]
    then
      echo "INFO: Matching package found, downloading: ${URL}"
      TMPDIR=$(mktemp -d)
      if curl -fLo "${TMPDIR}/motion.deb" "${URL}"
      then
        MOTION="${TMPDIR}/motion.deb"
      else
        echo 'WARNING: Download failed, installing (older) motion package from APT repository instead'
      fi
    else
      echo "WARNING: No motion package found for ${DISTRO^} on ${ARCH}, installing from APT repository instead"
    fi
  else
    echo 'WARNING: Distribution version could not be detected, installing motion from APT repository'
  fi
  LIBCAMERA_PACKAGES=()
  (( LIBCAMERA )) && LIBCAMERA_PACKAGES=('libcamera-v4l2')
  DEBIAN_FRONTEND='noninteractive' apt-get -y --no-install-recommends install "${MOTION}" v4l-utils ffmpeg curl "${LIBCAMERA_PACKAGES[@]}"
  [[ $TMPDIR ]] && rm -R "$TMPDIR"
elif command -v yum > /dev/null; then
  echo 'INFO: YUM-based distribution detected, installing motionEye dependencies'
  yum -y install motion v4l-utils ffmpeg curl
else
  echo 'WARNING: This system uses neither APT nor YUM. Please install these dependencies manually:
  motion v4l-utils ffmpeg curl'
fi

# Stop and mask conflicting motion.service
if systemctl -q is-active motion 2> /dev/null || systemctl -q is-enabled motion 2> /dev/null; then
  systemctl mask --now motion
fi

# Pre-create config and data dirs and install configuration files
if [[ -f '/etc/motioneye/motioneye.conf' ]]
then
  # Update PID file directory if the default from old motionEye is still present: https://github.com/motioneye-project/motioneye/issues/2657
  grep -q '^run_path /var/run$' /etc/motioneye/motioneye.conf && sed -i '\|^run_path /var/run$|c\run_path /run/motioneye' /etc/motioneye/motioneye.conf
else
  [[ -d '/etc/motioneye' ]] || mkdir /etc/motioneye
  cp extra/motioneye.conf.sample /etc/motioneye/motioneye.conf
fi
chown -R motion:motion /etc/motioneye
# The settings may contain credentials (motion_control_authentication), and motionEye is not supposed to write to this file
chown 0:motion /etc/motioneye/motioneye.conf
chmod 0640 /etc/motioneye/motioneye.conf
if (( LIBCAMERA )); then
  V4L2_COMPAT=$(dpkg -L libcamera-v4l2 2> /dev/null | grep -m1 '/v4l2-compat\.so$' || :)
  if [[ ! -f $V4L2_COMPAT ]]; then
    echo 'WARNING: v4l2-compat.so has not been found, please install the libcamera-v4l2 package and set "libcamera_v4l2" in /etc/motioneye/motioneye.conf to its path'
  elif grep -q '^libcamera_v4l2 ' /etc/motioneye/motioneye.conf; then
    sed -i "/^libcamera_v4l2 /c\libcamera_v4l2 $V4L2_COMPAT" /etc/motioneye/motioneye.conf
  else
    echo "INFO: Enabling libcamera's V4L2 layer in /etc/motioneye/motioneye.conf"
    if grep -q '^#libcamera_v4l2 ' /etc/motioneye/motioneye.conf; then
      sed -i "/^#libcamera_v4l2 /c\libcamera_v4l2 $V4L2_COMPAT" /etc/motioneye/motioneye.conf
    else
      [[ -n $(tail -c1 /etc/motioneye/motioneye.conf) ]] && echo >> /etc/motioneye/motioneye.conf
      echo "libcamera_v4l2 $V4L2_COMPAT" >> /etc/motioneye/motioneye.conf
    fi
  fi
fi

(( SKIP_SYSTEMD )) && exit 0

# Install service
cp extra/motioneye.systemd /etc/systemd/system/motioneye.service
# - Update meyectl path
sed -i "s|^ExecStart=/usr/local/bin/meyectl|ExecStart=$MEYECTL|" /etc/systemd/system/motioneye.service

systemctl daemon-reload
systemctl enable motioneye
systemctl restart motioneye
