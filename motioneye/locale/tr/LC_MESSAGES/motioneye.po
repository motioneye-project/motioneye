#: motioneye/config.py:1055
msgid "Device names are only allowed to contain alphanumerical characters, hyphen -, underscore _, plus +, and space"
msgstr "Cihaz adı sadece alfanumerik karakterler, tire -, alt tire _, artı +, ve boşluk içerebilir"

#: motioneye/config.py:1059
msgid "File names are only allowed to contain alphanumerical characters, parenthesis (), forward slash /, dot ., underscore _, hyphen -, space, and a subset of motion conversion specifiers: %C %Y %m %d %H %M %S %I %p %l %q %v %$"
msgstr "Dosya isimlerinde sadece alfanumerik karakterler, parantez (), eğik çizgi /, nokta ., tire -, alt tire _, boşluk, ve alt hareket dönüştürme belirleyicileri: %C %Y %m %d %H %M %S %I %p %l %q %v %$ bulunmasına izin verilir"

#: motioneye/config.py:1064
msgid "Directory names are only allowed to contain alphanumerical characters, space, parenthesis (), forward slash /, dot ., underscore _, and hyphen -"
msgstr "Dizin isimlerinde sadece alfanumerik karakterler, boşluk, parantez (), eğik çizgi /, nokta., tire - ve alt tire _ bulunmasına izin verilir"

#: motioneye/config.py:1069
#, fuzzy
msgid "Email addresses are only allowed to contain alphanumerical characters, underscore _, plus +, dot ., at @, caret ^, tilde ~, angle brackets <>, hyphen -, and may be separated by comma, and space"
msgstr "E-posta protokolü sadece alfanumeric karakterlere kılavuzdur, işaret altında, artı +, dot., @, caret^, tilde ~, İngilizce nouns < >, hyphen - ve komün tarafından iyi olabilir ve uzaysal olarak"

#: motioneye/config.py:1074
#, fuzzy
msgid "URLs are not allowed to contain caret ^, semicolon ;, or apostrophe '"
msgstr "URL'ler \"Complier\", yarı sömürge; veya apostrophe ‘ ‘ ‘"

