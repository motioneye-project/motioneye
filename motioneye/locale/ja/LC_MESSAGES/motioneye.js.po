msgstr "独自のファイルパス"

#: motioneye/static/js/main.js:2249
msgid "Retan kunlokon"
msgstr "オンラインコロケーション"

#: motioneye/static/js/main.js:2573
msgid "Via retumilo ne efektivigas ĉi tiun funkcion!"
msgstr "お使いのブラウザは、この機能を実装していません!"

#: motioneye/static/js/main.js:2589
msgid "Apliki"
msgstr "適用"

#: motioneye/static/js/main.js:2616 motioneye/static/js/main.js:2900
#: motioneye/static/js/main.js:2958 motioneye/static/js/main.js:3034
