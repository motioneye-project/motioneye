#: motioneye/static/js/main.js:390
msgid "An error occurred. Refreshing is recommended."
msgstr "エラーが発生しました。更新をお勧めします。"

#: motioneye/static/js/main.js:418
msgid "Sign in to Google in the new tab, and allow access."
msgstr "新しいタブで Google にサインインし、アクセスを許可してください。"

#: motioneye/static/js/main.js:419
msgid "The tab then shows a page that cannot be loaded, at an address starting with http://127.0.0.1/. This is expected."
msgstr "するとそのタブに、http://127.0.0.1/ で始まるアドレスの、読み込めないページが表示されます。これは想定どおりの動作です。"

#: motioneye/static/js/main.js:420
msgid "Copy the whole address from the address bar of that tab, and paste it as the authorization key."
msgstr "そのタブのアドレスバーからアドレス全体をコピーし、認証キーとして貼り付けてください。"

#: motioneye/static/js/main.js:426
msgid "Testing the upload with the new key replaces the current Google authorization, even before the settings are applied."
msgstr "新しいキーでアップロードをテストすると、設定を適用する前でも、現在の Google の認証が置き換えられます。"

#: motioneye/static/js/main.js:430
msgid "Obtaining the key from Google"
msgstr "Google から認証キーを取得する"

#: motioneye/static/js/main.js:486
msgid "specialaj signoj ne rajtas en pasvorto"
msgstr "パスワードに特殊文字は使用できません"

#: motioneye/static/js/main.js:493
msgid "use of colon (:) is not allowed in video streaming username"
msgstr "ビデオストリーミングのユーザ名にコロン (:) は使用できません"

#: motioneye/static/js/main.js:504
msgid "video streaming authentication mode must be Basic or Digest when admin-only access is enabled"
msgstr "管理者のみのアクセスを有効化している場合、ビデオストリーミングの認証モードは Basic または Digest でなければなりません"

#: motioneye/static/js/main.js:511 motioneye/static/js/main.js:522
#: motioneye/static/js/main.js:588 motioneye/static/js/ui.js:393
msgid "Ĉi tiu kampo estas deviga"
msgstr "この項目は必須です"

#: motioneye/static/js/main.js:515
msgid "specialaj signoj ne rajtas en la nomo de kamerao"
msgstr "カメラ名に特殊文字は使用できません"

#: motioneye/static/js/main.js:527
msgid "valoro devas esti multoblo de 8"
msgstr "値は 8 の倍数でなければなりません"

#: motioneye/static/js/main.js:534
msgid "specialaj signoj ne rajtas en radika voja nomo"
msgstr "ルートパス名に特殊文字は使用できません"

#: motioneye/static/js/main.js:537
msgid "dosieroj ne povas esti kreitaj rekte en la radiko de via sistemo"
msgstr "システムルートに直接ファイルを作成することはできません"

#: motioneye/static/js/main.js:544
msgid "The configured storage device is not writable. Recordings cannot be saved until write access is restored."
msgstr "設定されたストレージデバイスには書き込みできません。書き込みアクセスができるようになるまで、録画は保存されなくなります。"

#: motioneye/static/js/main.js:551
msgid "enigu validan retpoŝtadreson"
msgstr "正しい電子メールアドレスを入力してください"

#: motioneye/static/js/main.js:558
msgid "enigu liston de koma apartaj validaj retpoŝtadresoj"
msgstr "カンマ区切りで正しい電子メールアドレスのリストを入力してください"

#: motioneye/static/js/main.js:565
msgid "specialaj signoj ne rajtas en dosiernomo"
msgstr "ファイル名に特殊文字は使用できません"

#: motioneye/static/js/main.js:592
msgid "enigu validan valoron"
msgstr "有効な値を入力してください"

#: motioneye/static/js/main.js:744
msgid "Ĉi rekursie forigos ĉiujn dosierojn ĉeestantajn en la nuba dosierujo \""
msgstr "これを有効にすると、クラウドフォルダ内にあるすべてのファイルを再帰的に削除します。\""

#: motioneye/static/js/main.js:745
msgid "\", ne nur tiuj alŝutitaj de motionEye!"
msgstr "\"なお、 motionEye がアップロードしたもの以外も削除対象になります!"

#: motioneye/static/js/main.js:754
msgid "\"Purigi la nubon\" estis malŝaltita ĉar ĝi konfliktas kun \"Forigi Dosierojn Post Alŝuto\"."
msgstr "\"アップロード後にファイルを削除\" が有効化されているため、 \"クラウドのクリーンアップ\" が無効化されています。"

#: motioneye/static/js/main.js:846
msgid "Ĉi rekursie forigos ĉiujn malnovajn amaskomunikilajn dosierojn en la dosierujo \""
msgstr "これを有効にすると、フォルダ内にあるすべてのファイルを再帰的に削除します。\""

#: motioneye/static/js/main.js:847
msgid "\", ne nur tiuj kreitaj de motionEye!"
msgstr "\"なお、 motionEye がアップロードしたもの以外も削除対象になります!"

#: motioneye/static/js/main.js:931
msgid "Ne eblas redakti la maskon sen valida kameraa bildo!"
msgstr "有効なカメラ画像が無い場合、マスクを編集することはできません!"

#: motioneye/static/js/main.js:2200
msgid "Propra"
msgstr "独自設定"

#: motioneye/static/js/main.js:2233
