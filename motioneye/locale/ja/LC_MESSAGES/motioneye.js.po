msgid "Forigi"
msgstr "削除"

#: motioneye/static/js/main.js:3789
msgid "Kamerao tipo"
msgstr "カメラタイプ"

#: motioneye/static/js/main.js:3791
msgid "Loka V4L2-kamerao"
msgstr "ローカル V4L2 カメラ"

