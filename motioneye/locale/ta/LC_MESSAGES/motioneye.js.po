msgid "Ĉi tiu kampo estas deviga"
msgstr "இந்த புலம் கட்டாயமாகும்"

#: motioneye/static/js/main.js:500
msgid "specialaj signoj ne rajtas en la nomo de kamerao"
msgstr "கேமராவின் பெயரில் சிறப்பு எழுத்துக்கள் அனுமதிக்கப்படவில்லை"

#: motioneye/static/js/main.js:512
msgid "valoro devas esti multoblo de 8"
msgstr "மதிப்பு 8 இன் பெருக்கமாக இருக்க வேண்டும்"

#: motioneye/static/js/main.js:519
msgid "specialaj signoj ne rajtas en radika voja nomo"
msgstr "ரூட் சாலை பெயரில் சிறப்பு எழுத்துக்கள் அனுமதிக்கப்படவில்லை"

#: motioneye/static/js/main.js:522
msgid "dosieroj ne povas esti kreitaj rekte en la radiko de via sistemo"
msgstr "உங்கள் கணினியின் மூலத்தில் கோப்புகளை நேரடியாக உருவாக்க முடியாது"

#: motioneye/static/js/main.js:529
msgid "enigu validan retpoŝtadreson"
msgstr "சரியான மின்னஞ்சல் முகவரியை உள்ளிடவும்"

#: motioneye/static/js/main.js:536
msgid "enigu liston de koma apartaj validaj retpoŝtadresoj"
msgstr "கோமா தனி செல்லுபடியாகும் மின்னஞ்சல் முகவரிகளின் பட்டியலை உள்ளிடவும்"

#: motioneye/static/js/main.js:543
msgid "specialaj signoj ne rajtas en dosiernomo"
msgstr "கோப்பு பெயரில் சிறப்பு எழுத்துக்கள் அனுமதிக்கப்படவில்லை"

#: motioneye/static/js/main.js:570
msgid "enigu validan valoron"
msgstr "சரியான மதிப்பை உள்ளிடவும்"

#: motioneye/static/js/main.js:719
msgid "Ĉi rekursie forigos ĉiujn dosierojn ĉeestantajn en la nuba dosierujo \""
msgstr "இந்த மறுநிகழ்வு முகில் கோப்பகத்தில் இருக்கும் அனைத்து கோப்புகளையும் நீக்கும் \""

#: motioneye/static/js/main.js:720
msgid "\", ne nur tiuj alŝutitaj de motionEye!"
msgstr "\", மோசன் பதிவேற்றியவை மட்டுமல்ல!"

#: motioneye/static/js/main.js:729
msgid "\"Purigi la nubon\" estis malŝaltita ĉar ĝi konfliktas kun \"Forigi Dosierojn Post Alŝuto\"."
msgstr ""

#: motioneye/static/js/main.js:820
msgid "Ĉi rekursie forigos ĉiujn malnovajn amaskomunikilajn dosierojn en la dosierujo \""
msgstr "இந்த மறுநிகழ்வு கோப்பகத்தில் உள்ள அனைத்து பழைய ஊடக கோப்புகளையும் நீக்கும் \""

#: motioneye/static/js/main.js:821
msgid "\", ne nur tiuj kreitaj de motionEye!"
msgstr "\", மோசன் உருவாக்கியவை மட்டுமல்ல!"

#: motioneye/static/js/main.js:901
msgid "Ne eblas redakti la maskon sen valida kameraa bildo!"
msgstr "செல்லுபடியாகும் கேமரா படம் இல்லாமல் முகமூடியைத் திருத்த முடியவில்லை!"

#: motioneye/static/js/main.js:2168
msgid "Propra"
msgstr "சொந்தமானது"

#: motioneye/static/js/main.js:2206
msgid "Propra dosierindiko"
msgstr "சொந்த கோப்பு அறிகுறி"

