#: motioneye/templates/main.html:183
msgid "pasvorto de administranto"
msgstr "Administratörens lösenord"

#: motioneye/templates/main.html:186
msgid "Observanto"
msgstr "Övervakningsanvändare"

#: motioneye/templates/main.html:188
msgid "la uzantnomo por uzi por la monitorado"
msgstr "användarnamnet som ska användas för övervakning"

#: motioneye/templates/main.html:193
msgid "la pasvorto de la uzanto de monitorado"
msgstr "lösenordet för övervakningsanvändaren"

#: motioneye/templates/main.html:196
