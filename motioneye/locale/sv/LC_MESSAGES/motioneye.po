msgstr "Ström"

#: motioneye/templates/main.html:225
msgid "Fermu"
msgstr "Stäng av"

#: motioneye/templates/main.html:226
msgid "malŝaltas la sistemon"
msgstr "Stänger av systemet"

#: motioneye/templates/main.html:230
msgid "Rekomencu"
msgstr "Starta om"

#: motioneye/templates/main.html:231
msgid "rekomencas la sistemon"
msgstr "startar om systemet"

#: motioneye/templates/main.html:237
msgid "Agordo"
msgstr "Konfiguration"

#: motioneye/templates/main.html:238
msgid "Sekurkopio"
msgstr "Säkerhetskopia"

#: motioneye/templates/main.html:239
msgid "kreas dosieron kun la nuna agordo por ke vi konservu ĝin surloke"
msgstr "skapar en fil med den aktuella konfigurationen som du kan spara lokalt"

#: motioneye/templates/main.html:243
msgid "Restaŭri"
msgstr "Återställ"

#: motioneye/templates/main.html:244
msgid "restarigas la agordon el antaŭe konservita rezerva dosiero"
msgstr "återställer konfigurationen från en tidigare sparad säkerhetskopia"

#: motioneye/templates/main.html:268
msgid "aktivigu ĉi tion, se vi volas uzi ĉi tiun kameraon"
msgstr "Aktivera detta om du vill använda den här kameran"

#: motioneye/templates/main.html:269
msgid "Video-Aparato"
msgstr "Videoenhet"

#: motioneye/templates/main.html:274 motioneye/templates/main.html:637
#: motioneye/templates/main.html:654
msgid "Kamerao Nomo"
msgstr "Kameranamn"

#: motioneye/templates/main.html:275
msgid "kameraa nomo…"
msgstr "Kameranamn…"

#: motioneye/templates/main.html:276
msgid "alias pri ĉi tiu kamera aparato"
msgstr "ett alias för den här kameraenheten"

#: motioneye/templates/main.html:279
msgid "Kamerao ID"
msgstr "Kamera-ID"

#: motioneye/templates/main.html:281
msgid "la kamerao identiga numero"
msgstr "kamerans identifieringsnummer"

#: motioneye/templates/main.html:284
msgid "Kamerao aparato"
msgstr "Kameraenhet"

#: motioneye/templates/main.html:286
msgid "Eniga aparato (ekz. : /dev/video) or URL (ekz. : rtsp://192.168.1.1/stream)"
msgstr "Ingångsenhet (t.ex. /dev/video) eller URL (t.ex. rtsp://192.168.1.1/stream)"

#: motioneye/templates/main.html:289
msgid "Kamerao Tipo"
msgstr "Kameratyp"

#: motioneye/templates/main.html:293
msgid "Connection"
msgstr "Anslutning"

#: motioneye/templates/main.html:294
msgid "Edit Credentials"
msgstr "Redigera inloggningsuppgifter"

#: motioneye/templates/main.html:295
msgid "edit the camera URL and credentials"
msgstr "redigera kamerans URL och inloggningsuppgifter"

#: motioneye/templates/main.html:298
msgid "Admin-only access"
msgstr "Endast administratörsåtkomst"

#: motioneye/templates/main.html:300
msgid "If enabled only the admin user can access this camera"
msgstr "Om detta är aktiverat kan endast administratören komma åt den här kameran"

#: motioneye/templates/main.html:306
msgid "Aŭtomata Brilo"
msgstr "Automatisk ljusstyrka"

#: motioneye/templates/main.html:308
msgid "ebligas aŭtomatan brilon de programaro (rekomendita nur por kameraoj sen aŭtomata brilo)"
msgstr "aktiverar automatisk programvarubaserad ljusstyrka (rekommenderas endast för kameror utan automatisk ljusstyrka)"

#: motioneye/templates/main.html:314
msgid "Video-rezolucio"
msgstr "Videoupplösning"

#: motioneye/templates/main.html:319
msgid "la video-rezolucio (pli grandaj valoroj produktas pli bonan kvaliton, sed postulas pli da CPU-potenco, pli granda stokado kaj larĝa de bando)"
msgstr "videoupplösningen (högre värden ger bättre kvalitet men kräver mer CPU-kraft, lagringsutrymme och bandbredd)"

#: motioneye/templates/main.html:322
msgid "Larĝeco"
msgstr "Bredd"

#: motioneye/templates/main.html:324
msgid "enigu kutiman rezolucian larĝon"
msgstr "ange en anpassad upplösningsbredd"

#: motioneye/templates/main.html:327
msgid "Alteco"
msgstr "Höjd"

#: motioneye/templates/main.html:329
msgid "enigu kutiman rezolucian altecon"
msgstr "ange en anpassad upplösningshöjd"

#: motioneye/templates/main.html:332
msgid "Video-Rotacio"
msgstr "Videorotation"

#: motioneye/templates/main.html:341
msgid "uzu ĉi tion por turni la kaptitan bildon, se via kamerao ne estas poziciigita ĝuste"
msgstr "använd detta för att rotera den tagna bilden om kameran inte är korrekt placerad"

#: motioneye/templates/main.html:344
msgid "Kadrofrekvenco"
msgstr "Bildfrekvens"

#: motioneye/templates/main.html:346
msgid "agordas la nombron de kadroj kaptitaj de la kamerao ĉiun sekundon (pli altaj valoroj produktas pli mildajn filmetojn sed postulas pli da CPU-potenco, pli grandan stokadon kaj larĝan bandon)"
msgstr "anger antalet bildrutor som kameran tar per sekund (högre värden ger jämnare video men kräver mer CPU-kraft, lagringsutrymme och bandbredd)"

#: motioneye/templates/main.html:352
msgid "Privateca masko"
msgstr "Integritetsmask"

#: motioneye/templates/main.html:354
msgid "ebligas maskeradon de bildoj por eviti registradon de iuj bildaj areoj por protekti privatecon"
msgstr "aktiverar bildmaskning för att undvika inspelning av vissa områden i bilden och skydda integriteten"

#: motioneye/templates/main.html:359 motioneye/templates/main.html:1040
msgid "Redakti maskon"
msgstr "Redigera mask"

#: motioneye/templates/main.html:360 motioneye/templates/main.html:1041
msgid "Konservi maskon"
msgstr "Spara mask"

#: motioneye/templates/main.html:363
msgid "alklaku ĉi tiun butonon por ebligi/malebligi la maskan redaktilon"
msgstr "Klicka på den här knappen för att aktivera/inaktivera maskredigeraren"

#: motioneye/templates/main.html:374
msgid "Ekstraj Elektoj"
msgstr "Extra alternativ"

#: motioneye/templates/main.html:376
msgid "vi povas aldoni iujn ajn pliajn opciojn ĉi tie por la «motion» demono (uzu la «nomo valoro» formaton, unu opcion por linio)"
msgstr "Du kan lägga till valfria ytterligare alternativ här för demonen ”motion” (använd formatet ”namn värde”, ett alternativ per rad)"

#: motioneye/templates/main.html:385
msgid "elektu kie kaj kiel viaj amaskomunikiloj estas konservitaj"
msgstr "välj var och hur dina medier sparas"

#: motioneye/templates/main.html:386
msgid "Stokado de dosieroj"
msgstr "Fillagring"

#: motioneye/templates/main.html:391
msgid "Stokada Aparato"
msgstr "Lagringsenhet"

#: motioneye/templates/main.html:396
msgid "indikas la stokan aparaton, kie la bildo kaj video-dosieroj estos konservitaj"
msgstr "anger lagringsenheten där bild- och videofiler sparas"

#: motioneye/templates/main.html:399
msgid "Retservilo"
msgstr "Nätverksserver"

#: motioneye/templates/main.html:401
msgid "la adreso de la retservilo (IP-adreso aŭ nomo)"
msgstr "serverns adress (IP-adress eller värdnamn)"

#: motioneye/templates/main.html:404
msgid "SMB Protokolo-Versio"
msgstr "SMB-protokollversion"

#: motioneye/templates/main.html:414
msgid "elektu la SMB-version, kiun vi povas uzi (testu la malsamajn eblojn kaj vidu, kiu funkcias plej bone kun via NAS)"
msgstr "välj den SMB-version som ska användas (testa de olika alternativen och se vilket som fungerar bäst med din NAS)"

#: motioneye/templates/main.html:417
msgid "Kunhava nomo"
msgstr "Utdelningsnamn"

#: motioneye/templates/main.html:419
msgid "la nomo de la interŝanĝa reto"
msgstr "namnet på nätverksresursen"

#: motioneye/templates/main.html:422 motioneye/templates/main.html:534
#: motioneye/templates/main.html:722
msgid "Uzantnomo"
msgstr "Användarnamn"

#: motioneye/templates/main.html:424
msgid "la uzantnomo kiu estu provizita kiam vi aliras la reton dosierujon (lasu malplena se neniu uzantnomo estas bezonata)"
msgstr "användarnamnet som ska anges vid åtkomst till nätverksmappen (lämna tomt om inget användarnamn behövs)"

#: motioneye/templates/main.html:427
msgid "Pasvorton"
msgstr "Lösenord"

#: motioneye/templates/main.html:429
msgid "la pasvorto bezonata de la reto dosierujo (lasi malplena se neniu pasvorto estas bezonata)"
msgstr "lösenordet som krävs för nätverksmappen (lämna tomt om inget lösenord behövs)"

#: motioneye/templates/main.html:432
msgid "Radika dosierujo"
msgstr "Rotkatalog"

#: motioneye/templates/main.html:434
msgid "la radika vojo (sur la elektita stokada aparato), kie la dosieroj estos konservitaj"
msgstr "rotkatalogen (på den valda lagringsenheten) där filerna ska sparas"

#: motioneye/templates/main.html:438
msgid "Testi la reton dosierujon"
msgstr "Testa nätverksmapp"

#: motioneye/templates/main.html:439
msgid "alklaku ĉi tiun butonon por testi la retan kunlokon post kiam vi plenigis la postulatajn detalojn"
msgstr "Klicka på den här knappen för att testa anslutningen till nätverksmappen efter att du har fyllt i de nödvändiga uppgifterna"

#: motioneye/templates/main.html:445
msgid "Uzado de Disko"
msgstr "Diskanvändning"

#: motioneye/templates/main.html:449
msgid "la uzata/tuta grandeco de la disko, kie loĝas la radika dosierujo"
msgstr "den använda/totala storleken på disken där rotkatalogen finns"

#: motioneye/templates/main.html:455
msgid "Alŝutu Mediajn Dosierojn"
msgstr "Ladda upp mediefiler"

#: motioneye/templates/main.html:457
msgid "aktivigu ĉi tiun opcion, se vi volas, ke viaj amaskomunikiloj estu alŝutitaj al ekstera servo"
msgstr "aktivera detta om du vill att dina mediefiler ska laddas upp till en extern tjänst"

#: motioneye/templates/main.html:460
msgid "Alŝutu Bildojn"
msgstr "Ladda upp bilder"

#: motioneye/templates/main.html:462
msgid "aktivigu ĉi tiun opcion, se vi volas, ke la bildoj elŝutiĝu al ekstera servo"
msgstr "aktivera detta om du vill att bilder ska laddas upp till en extern tjänst"

#: motioneye/templates/main.html:465
msgid "Alŝutu Filmojn"
msgstr "Ladda upp filmer"

#: motioneye/templates/main.html:467
msgid "ebligu ĉi tion, se vi volas, ke filmetoj estu alŝutitaj al ekstera servo"
msgstr "aktivera detta om du vill att filmer ska laddas upp till en extern tjänst"

#: motioneye/templates/main.html:470
msgid "Alŝuta Servo"
msgstr "Uppladdningstjänst"

#: motioneye/templates/main.html:473
msgid "Servilo FTP"
msgstr "FTP-server"

#: motioneye/templates/main.html:474
msgid "Servilo SFTP"
msgstr "SFTP-server"

#: motioneye/templates/main.html:475
msgid "Servilo HTTP"
msgstr "HTTP-server"

#: motioneye/templates/main.html:476
msgid "Servilo HTTPS"
msgstr "HTTPS-server"

#: motioneye/templates/main.html:484
msgid "elektu servon, al kiu la mediadosieroj estu alŝutitaj"
msgstr "välj tjänsten som mediefilerna ska laddas upp till"

#: motioneye/templates/main.html:487
msgid "Servila Adreso"
msgstr "Serveradress"

#: motioneye/templates/main.html:489
msgid "la domajna nomo aŭ IP-adreso de la servilo (ekz. ftp.example.com aŭ 192.168.1.3)"
msgstr "domännamnet eller IP-adressen till servern (t.ex. ftp.example.com eller 192.168.1.3)"

#: motioneye/templates/main.html:492
msgid "Servila haveno"
msgstr "Serverport"

#: motioneye/templates/main.html:494
msgid "la haveno por uzi konekti al la servo (lasu ĉi tiun kampon malplena por uzi la defaŭltan valoron)"
msgstr "porten som används för att ansluta till tjänsten (lämna fältet tomt för att använda standardvärdet)"

#: motioneye/templates/main.html:497
msgid "Metodo"
msgstr "Metod"

#: motioneye/templates/main.html:504
msgid "la HTTP-metodo uzi por alŝuti dosierojn"
msgstr "HTTP-metoden som ska användas när du laddar upp filer"

#: motioneye/templates/main.html:507
msgid "Finpunkto URL"
msgstr "Slutpunkts-URL"

#: motioneye/templates/main.html:509
msgid "La kompleta URL al la alŝuta servila finpunkto:"
msgstr "Den fullständiga URL:en till uppladdningstjänstens slutpunkt:"

#: motioneye/templates/main.html:510
msgid "Por S3: ekz. http://my.minio:9000. Lasu ĝin malplena por AWS!"
msgstr "För S3: t.ex. http://my.minio:9000. Lämna tomt för AWS!"

#: motioneye/templates/main.html:511
msgid "Por WebDAV: ekz. https://my.cloud/remote.php/dav/files/Me/"
msgstr "För WebDAV: t.ex. https://my.cloud/remote.php/dav/files/Me/"

#: motioneye/templates/main.html:514
msgid "Loko"
msgstr "Plats"

#: motioneye/templates/main.html:516
msgid "la loko (radika vojo) kie amaskomunikiloj devas esti alŝutitaj (ekz. /files/cam1/)"
msgstr "platsen (rotsökvägen) dit mediefiler ska laddas upp (t.ex. /files/cam1/)"

#: motioneye/templates/main.html:519
msgid "Inkluzivi Subdosierujojn"
msgstr "Inkludera undermappar"

#: motioneye/templates/main.html:521
msgid "Aktivigu tion por elŝuti plurmediajn dosierojn kun siaj subdosierujoj, anstataŭ meti ilin rekte en la radikan lokon"
msgstr "Aktivera detta för att ladda upp mediefiler tillsammans med sina undermappar i stället för att placera dem direkt i rotplatsen"

#: motioneye/templates/main.html:524
