#: motioneye/config.py:956
msgid "Device names are only allowed to contain alphanumerical characters, hyphen -, underscore _, plus +, and space"
msgstr "Enhetsnamn får endast innehålla alfanumeriska tecken, bindestreck -, understreck _, plustecken + och mellanslag"

#: motioneye/config.py:960
msgid "File names are only allowed to contain alphanumerical characters, parenthesis (), forward slash /, dot ., underscore _, hyphen -, space, and a subset of motion conversion specifiers: %C %Y %m %d %H %M %S %I %p %l %q %v %$"
msgstr "Filnamn får endast innehålla alfanumeriska tecken, parenteser (), snedstreck /, punkt ., understreck _, bindestreck -, mellanslag och en delmängd av motions konverteringsspecifikatorer: %C %Y %m %d %H %M %S %I %p %l %q %v %$"

#: motioneye/config.py:965
msgid "Directory names are only allowed to contain alphanumerical characters, space, parenthesis (), forward slash /, dot ., underscore _, and hyphen -"
msgstr "Katalognamn får endast innehålla alfanumeriska tecken, mellanslag, parenteser (), snedstreck /, punkt ., understreck _ och bindestreck -"

#: motioneye/config.py:970
msgid "Email addresses are only allowed to contain alphanumerical characters, underscore _, plus +, dot ., at @, caret ^, tilde ~, angle brackets <>, hyphen -, and may be separated by comma, and space"
msgstr "E-postadresser får endast innehålla alfanumeriska tecken, understreck _, plustecken +, punkt ., snabel-a @, cirkumflex ^, tilde ~, vinkelparenteser <>, bindestreck - och får avgränsas med kommatecken och mellanslag"

#: motioneye/config.py:975
msgid "URLs are not allowed to contain caret ^, semicolon ;, or apostrophe '"
msgstr "URL:er får inte innehålla cirkumflex ^, semikolon ; eller apostrof '"

#: motioneye/meyectl.py:347
msgid "The admin and/or surveillance user has no password assigned. Please login to the web interface to set both passwords."
msgstr "Administratören och/eller övervakningsanvändaren har inget lösenord angivet. Logga in i webbgränssnittet för att ange båda lösenorden."

